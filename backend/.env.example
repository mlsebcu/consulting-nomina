NODE_ENV=development
PORT=3000

# Neon: usar la cadena "pooled" del panel y DB_SSL=true
DATABASE_URL=postgresql://usuario:password@localhost:5432/nomina_consulting
DB_SSL=false

# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Orígenes permitidos separados por coma
CORS_ORIGINS=http://localhost:5173

# Solo para `npm run seed:admin`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
